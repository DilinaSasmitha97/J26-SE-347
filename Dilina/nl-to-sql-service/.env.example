# Copy to .env and fill in. Never commit .env.
# Provider options: openrouter, groq, sambanova, cerebras, gemini, openai
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen-2.5-coder-32b-instruct
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
SAMBANOVA_API_KEY=
CEREBRAS_API_KEY=

# SQL Server (only needed for db_id=nemsuerp live access; cached schema works without)
DB_SERVER=
DB_NAME=
DB_USER=
DB_PASSWORD=

# Optional: Spider train set for few-shot exemplars (disabled if missing)
SPIDER_TRAIN_PATH=

# Service
PORT=8000
NGROK_AUTHTOKEN=
