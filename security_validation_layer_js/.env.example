# Copy to .env and fill in. .env is git-ignored.
# Without DB_NAME the demo still runs, but the Controlled Write Protocol is disabled.
DB_HOST=localhost
DB_PORT=3306
# Use a least-privilege account, not root:
#   CREATE USER 'svl_app'@'localhost' IDENTIFIED BY '...';
#   GRANT SELECT, INSERT, UPDATE, DELETE ON svl_demo.* TO 'svl_app'@'localhost';
DB_USER=svl_app
DB_PASSWORD=
DB_NAME=svl_demo

# Read-query execution limits
QUERY_MAX_ROWS=1000
QUERY_TIMEOUT_MS=5000

# NER side service (pii_service/ner_service.py) for names in text.
# closed = if it is down, text columns are fully masked; open = left unchecked (warning only)
NER_URL=http://127.0.0.1:5002
NER_FAIL_MODE=closed

# Controlled Write Protocol limits
WRITE_MAX_AFFECTED_ROWS=100
WRITE_APPROVAL_TTL_MINUTES=15
WRITE_REQUIRED_APPROVALS=1
