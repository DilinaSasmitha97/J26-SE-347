# Node backend and connected services
PORT=5000
NL_SERVICE_URL=http://127.0.0.1:8000/api/v1/translate
SQLGLOT_SERVICE_URL=http://127.0.0.1:8001/inspect
NER_URL=http://127.0.0.1:5002
NER_FAIL_MODE=closed

# Shared MySQL database used by secure execution
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=svl_app
MYSQL_PASSWORD=
MYSQL_DATABASE=multi_tenant_hr
DB_CONNECTION_LIMIT=5
QUERY_MAX_ROWS=100
QUERY_TIMEOUT_MS=5000

# Portable demo fallback. Set DB_TYPE=sqlite to use it directly, or leave
# SQLITE_FALLBACK=true to use it only when MySQL cannot be reached/authenticated.
DB_TYPE=mysql
SQLITE_FALLBACK=true
SQLITE_DATABASE_PATH=

# Optional: 64 hexadecimal characters for reversible pseudonyms.
# Without this key, configured FPE actions fall back to redaction.
FPE_KEY=
