# Copy to .env and fill in. The pipeline runs without these keys in
# deterministic mode (LLM_PROVIDER=none), which is what evaluation uses.

LLM_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=

# Synthetic MySQL test database (test_db/). Only needed for the integration
# fixtures; the component itself never connects to a database.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_ADMIN_USER=root
MYSQL_ADMIN_PASSWORD=
MYSQL_DATABASE=c4_synthetic
# Written by test_db/seed.py when absent:
MYSQL_READER_USER=c4_reader
MYSQL_READER_PASSWORD=
